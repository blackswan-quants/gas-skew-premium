# Copy to .env and adjust. Every key is optional; defaults shown.
# Relative paths are resolved against the project root.
GASSKEW_DATA_DIR=data
GASSKEW_CHECKPOINT_DIR=data/checkpoints
GASSKEW_OUTPUT_DIR=outputs
GASSKEW_DB_NAME=gasskew.sqlite
GASSKEW_LOG_LEVEL=INFO

# Data-vendor API keys go here once a source is chosen. Add the matching required
# field to src/gasskew/config.py so a missing key fails at start-up, e.g.
# GASSKEW_VENDOR_API_KEY=
